{
  "name": "Kanchan · Daily stock watch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every morning 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/products",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,slug,name_bn,name_en,price,availability,published,updated_at" },
            { "name": "order", "value": "sort_order.asc,id.asc" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Read catalogue (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// Build a short, phone-friendly list of things to fix before opening.\nconst products = Array.isArray($input.all()) && $input.all().length === 1 && Array.isArray($input.first().json)\n  ? $input.first().json\n  : $input.all().map(item => item.json);\n\nconst OUT = products.filter(p => p.availability === 'out-of-stock');\nconst UNKNOWN_STOCK = products.filter(p => !p.availability);\nconst UNPUBLISHED = products.filter(p => p.published === false);\nconst NO_PRICE = products.filter(p => p.published !== false && (p.price === null || p.price === undefined));\n\nconst line = p => `• ${p.name_bn || p.name_en} (${p.slug})`;\nconst sections = [];\nif (OUT.length) sections.push(`Out of stock:\\n${OUT.map(line).join('\\n')}`);\nif (UNKNOWN_STOCK.length) sections.push(`Stock not updated:\\n${UNKNOWN_STOCK.map(line).join('\\n')}`);\nif (NO_PRICE.length) sections.push(`Price missing:\\n${NO_PRICE.map(line).join('\\n')}`);\nif (UNPUBLISHED.length) sections.push(`${UNPUBLISHED.length} draft(s) not published yet.`);\n\nconst issueCount = OUT.length + UNKNOWN_STOCK.length + NO_PRICE.length;\nreturn [{\n  json: {\n    issueCount,\n    productCount: products.length,\n    message: sections.length\n      ? `Kanchan Cycle Stores — daily stock check\\n\\n${sections.join('\\n\\n')}\\n\\nOpen the owner stock desk to fix this.`\n      : `Kanchan Cycle Stores — all ${products.length} published products look up to date.`\n  }\n}];"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Summarise what needs attention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.issueCount }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Anything to fix?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Telegram the shop",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, -120]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SHOP_ALERT_FROM }}",
        "toEmail": "={{ $env.SHOP_ALERT_TO }}",
        "subject": "Kanchan stock check — {{ $json.issueCount }} item(s) to review",
        "text": "={{ $json.message }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Email the shop",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 100]
    }
  ],
  "connections": {
    "Every morning 9 AM": { "main": [[{ "node": "Read catalogue (Supabase)", "type": "main", "index": 0 }]] },
    "Read catalogue (Supabase)": { "main": [[{ "node": "Summarise what needs attention", "type": "main", "index": 0 }]] },
    "Summarise what needs attention": { "main": [[{ "node": "Anything to fix?", "type": "main", "index": 0 }]] },
    "Anything to fix?": {
      "main": [
        [
          { "node": "Telegram the shop", "type": "main", "index": 0 },
          { "node": "Email the shop", "type": "main", "index": 0 }
        ],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "active": false,
  "versionId": "a1b2c3d4-0007-4000-8000-000000000007",
  "meta": { "templateCredsSetupCompleted": false },
  "tags": []
}
