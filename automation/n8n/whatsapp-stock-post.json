    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/products",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "slug,name_bn,name_en,price,availability,featured" },
            { "name": "published", "value": "eq.true" },
            { "name": "availability", "value": "eq.in-stock" },
            { "name": "order", "value": "featured.desc,sort_order.asc" },
            { "name": "limit", "value": "12" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
